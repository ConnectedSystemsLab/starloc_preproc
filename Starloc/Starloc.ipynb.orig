    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Coarse GS:  [ 40.32123351 -88.16987191]\n",
      "Coarse location error in kilometers : [23.19810352]\n",
      "STARLINK-3505:  True\n",
      "STARLINK-5749:  True\n",
      "STARLINK-3361:  True\n",
      "STARLINK-4559:  True\n",
      "STARLINK-3507:  True\n",
      "STARLINK-5799:  True\n",
      "STARLINK-3501:  True\n",
      "STARLINK-4553:  True\n"
     ]
    }
   ],
   "source": [
    "from sat_id import get_phase_diff_params_allsatsingroups_jida, calc_doppler_blind_id\n",
    "from utils.helper import get_distkm_latlon_coordinates\n",
    "from tqdm import tqdm\n",
    "slope_mes = sio.loadmat(date+'/doppler_track.mat')['slope_mes']\n",
    "phase_slope = get_phase_diff_params_allsatsingroups_jida(gs_groups, coarse_gs, sat_groups, time_arr+start_time, date+'/Starlink.tle', 0, pitch, roll, d, lam)\n",
    "phase_slope = np.array(phase_slope)\n",
    "\n",
    "err = np.array([])\n",
    "max_phase_err_pergs = [[] for i in range(len(gs_groups))]\n",
    "refined_candidates = []\n",
    "remove_candidates = []\n",
    "for i in (range(len(gs_groups))):\n",
    "    sat_group_i = sat_groups[i]\n",
    "    coarse_gs_i = coarse_gs[i]\n",
    "    phase_slope_i = phase_slope[i]\n",
    "    err_i = 0\n",
    "    for j in range(len(sat_group_i)):\n",
    "\n",
    "        # exclude based on phase slope\n",
    "        if np.max(np.abs(phase_slope_i[j] - slope_mes[j])) > 0.1:\n",
    "            err_i = np.inf\n",
    "            max_phase_err_pergs[i] = np.max(np.abs(phase_slope_i[j] - slope_mes[j]))\n",
    "            if i in refined_candidates:\n",
    "                remove_candidates.append(i)\n",
    "            break\n",
    "        else:\n",
    "            max_phase_err_pergs[i] = np.max(np.abs(phase_slope_i[j] - slope_mes[j]))\n",
    "            refined_candidates.append(i)\n",
    "\n",
    "        sat_ij = sat_group_i[j]\n",
    "        dopp_coeff = dopp_coeff_list[j]\n",
    "        dopp_track = dopp_track_main_dict[0, j]\n",
    "        t_repeat = dopp_track[:, 0].real\n",
    "        dopp_repeat = dopp_track[:, 1].real\n",
    "        t_sat_start, t_sat_end = np.min(t_repeat), np.max(t_repeat)\n",
    "        _, t_dopp_sim, dopp_sim, _, _, _ = calc_doppler_blind_id(sat_ij, coarse_gs_i, t_sat_start+start_time, t_sat_end+start_time, 10)\n",
    "        t_dopp_sim += t_sat_start\n",
    "        dopp_mes = np.polyval(dopp_coeff, t_dopp_sim)\n",
    "        err_i += np.var(dopp_mes-dopp_sim)\n",
    "    err = np.append(err, err_i)\n",
    "print('Coarse GS: ', coarse_gs[np.argmin(err)])\n",
    "coarse_gs_lat, coarse_gs_lon = coarse_gs[np.argmin(err)]\n",
    "print('Coarse location error in kilometers :', get_distkm_latlon_coordinates([lat_gt, lon_gt], [coarse_gs_lat, coarse_gs_lon]))\n",
    "for j in range(len(sat_group_i)):\n",
    "    print(id_dict[0][j][0] + ': ', sat_groups[np.argmin(err)][j].name == id_dict[0][j][0])\n",
    "sio.savemat(date+'/blind_id.mat', {'coarse_lat': coarse_gs_lat, 'coarse_lon': coarse_gs_lon})"
   ]
  },
