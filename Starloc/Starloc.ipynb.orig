    "    dopp_repeat = dopp_track[:, 1].real\n",
    "    t_sat_start, t_sat_end = np.min(t_repeat), np.max(t_repeat)\n",
    "\n",
    "    t_sim, dopp_gt, az_gt, el_gt, range_gt = dopp_sim_1_sat(date, date+'/Starlink.tle', id_dict[0,sat_idx][0], start_time+t_sat_start, start_time+t_sat_end, .001, lat_gt, lon_gt, alt_gt)\n",
