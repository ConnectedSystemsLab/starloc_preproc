    "    p = np.polyfit(t_repeat, dopp_repeat-freq_offset_, 3, w=np.abs(dopp_track[:, 2]))\n",
    "    \n",
    "    tt_sim_list.append(t_sim)\n",
    "    p_list.append(p)\n",
    "    az_gt_dopp_list.append(np.deg2rad(az_gt))\n",
