       "                <img src='data:image/png;base64,' width=1000.0/>\n",
       "            </div>\n",
       "        "
      ],
      "text/plain": [
       "Canvas(toolbar=Toolbar(toolitems=[('Home', 'Reset original view', 'home', 'home'), ('Back', 'Back to previous …"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# first cheat by using the gt location to get the random phase offset (mean value for all satellites)\n",
    "from sat_id import aoa_sim_1_sat, aoa_sim_1_sat_eph\n",
    "\n",
    "# tracked tones' phase diff\n",
    "del_phi_repeat_01_list, del_phi_repeat_12_list, coeff_01_list, coeff_12_list, del_phi_01_gt_list, del_phi_12_gt_list, t_sim_arr, az_gt_list, el_gt_list, range_gt_list = [], [], [], [], [], [], [], [], [], []\n",
    "d, lam = 13.25e-2, 299792458/fc\n",
    "loc_1, loc_0, loc_2 = np.array([0,0,0]), np.array([0,-d,0]), np.array([d,0,0])\n",
    "\n",
    "# consider orientation - 2: yaw, pitch, roll from imudata\n",
    "orient = imu.get_attitude()\n",
    "yaw, pitch, roll = np.mean(orient[2][-3000:-1]), np.mean(orient[1]), np.mean(orient[0])\n",
    "# yaw = 0\n",
    "R_yaw = np.array([[np.cos(np.deg2rad(yaw)), -np.sin(np.deg2rad(yaw)), 0], [np.sin(np.deg2rad(yaw)), np.cos(np.deg2rad(yaw)), 0], [0, 0, 1]])\n",
    "R_pitch = np.array([[np.cos(np.deg2rad(pitch)), 0, np.sin(np.deg2rad(pitch))], [0, 1, 0], [-np.sin(np.deg2rad(pitch)), 0, np.cos(np.deg2rad(pitch))]])\n",
    "R_roll = np.array([[1, 0, 0], [0, np.cos(np.deg2rad(roll)), -np.sin(np.deg2rad(roll))], [0, np.sin(np.deg2rad(roll)), np.cos(np.deg2rad(roll))]])\n",
    "R = R_yaw @ R_pitch @ R_roll\n",
    "loc_0, loc_2 = R @ loc_0, R @ loc_2\n",
    "\n",
    "# first solve ambiguity\n",
    "gap_01_arr, gap_12_arr = np.array([]), np.array([]) \n",
    "gap_01_coarse_arr, gap_12_coarse_arr = np.array([]), np.array([])\n",
    "for sat_idx in range(sat_num):\n",
    "    # time for tracked tones\n",
    "    dopp_track = dopp_track_dict[0, sat_idx]\n",
    "    t_repeat = dopp_track[:, 0].real\n",
    "    t_sat_start, t_sat_end = t_repeat[0], t_repeat[-1]\n",
    "\n",
    "    # gt location\n",
    "    t_sim, az_gt, el_gt, range_gt = aoa_sim_1_sat(date, date+'/Starlink.tle', id_dict[0,sat_idx][0], start_time+t_sat_start, start_time+t_sat_end, .1, lat_gt, lon_gt, alt_gt)\n",
    "    t_sim += t_sat_start\n",
    "    az_gt, el_gt = np.deg2rad(az_gt), np.deg2rad(el_gt)\n",
    "\n",
    "    # coarse location\n",
    "    _, az_coarse, el_coarse, range_coarse = aoa_sim_1_sat(date, date+'/Starlink.tle', id_dict[0,sat_idx][0], start_time+t_sat_start, start_time+t_sat_end, .1, coarse_gs_lat, coarse_gs_lon)\n",
    "    az_coarse, el_coarse = np.deg2rad(az_coarse), np.deg2rad(el_coarse)\n",
    "    \n",
    "    loc_sat = np.column_stack((range_gt * np.cos(el_gt) * np.sin(az_gt), range_gt * np.cos(el_gt) * np.cos(az_gt), range_gt * np.sin(el_gt)))\n",
    "    loc_sat_coarse = np.column_stack((range_coarse * np.cos(el_coarse) * np.sin(az_coarse), range_coarse * np.cos(el_coarse) * np.cos(az_coarse), range_coarse * np.sin(el_coarse)))\n",
    "\n",
    "    # subtract the ref sig's phase\n",
    "    ref_sig_ii = np.argmin(np.abs(ref_sig_idx[:, 0]/sample_rate-(t_sat_start+t_sat_end)/2))\n",
    "    phase_offset_01_ = phase_offset_01[ref_sig_ii]\n",
    "    phase_offset_12_ = -phase_offset_21[ref_sig_ii]\n",
    "\n",
    "    # delta phi from measured dopp\n",
    "    del_phi_repeat_01 = np.unwrap(np.angle(dopp_track[:, 2])-np.angle(dopp_track[:, 3])) - phase_offset_01_\n",
    "    del_phi_repeat_12 = np.unwrap(np.angle(dopp_track[:, 3])-np.angle(dopp_track[:, 4])) - phase_offset_12_\n",
    "\n",
    "    if date == '12Mar2024_23_17':\n",
    "        ph_01 = np.array([0.0265, -0.1879, -0.4471, 0.5471-0.4471, 0, -0.0205, -0.2517, 0.0388])\n",
    "        ph_12 = np.array([0.124, 0.3485, 0.6128, 0.3722, 0, -0.0436, -0.0111, -0.0266])\n",
    "    elif date == '12Mar2024_23_35':\n",
    "        ph_01 = np.array([-0.3717, -0.441, -0.0965, 0, -0.0711, 0.093, -0.1751])\n",
    "        ph_12 = np.array([0.3368, 0.2334, 0.127, 0, 0.0642, -0.3294, 0.0804])\n",
    "    elif date == '13Mar2024_00_35':\n",
    "        ph_01 = np.array([0.0434, 0.0658, 0.0982, 0, 0.2041, 0.2524, 0.1915])\n",
    "        ph_12 = np.array([-0.088, -0.0152, -0.0456, 0, -0.0042, -0.2524, 0.0107])\n",
    "    elif date == '13Mar2024_00_54':\n",
    "        ph_01 = np.array([-0.1525, -0.0716, 0.0106, 0, -0.0425, -0.0884])\n",
    "        ph_12 = np.array([0.0309, -0.0541, -0.0504, 0, 0.0549, -0.0265])\n",
    "    elif date == '13Mar2024_02_20':\n",
    "        ph_01 = np.array([0, 0.3867, -0.0084, 0.0772, 0, -0.0086, 0.0027])\n",
    "        ph_12 = np.array([0, 0.3065, 0.041, 0.0999, 0, -0.2111, -0.1374])\n",
    "    elif date == '13Mar2024_03_17':\n",
    "        ph_01 = np.array([.2502, 0.2758, .6393, .3719, .3841, .4612, .4780, .1039, .0887, 0, -.2136, -.0503])\n",
    "        ph_12 = np.array([.1403, 0.1249, -0.2433, .0103, -.0208, .0372, -0.0372, .0276, -.2927, 0, -.0557, -.0443])\n",
    "    elif date == '13Mar2024_03_59':\n",
    "        ph_01 = np.array([0.0024, 0, 0.0162, 0.166])\n",
    "        ph_12 = np.array([0.0714, 0, -0.0299, -0.3093])\n",
    "    elif date == '13Mar2024_05_37':\n",
    "        ph_01 = np.array([-.0296, 0, 0.0765, 0.0456, 0.1201, 0.2308, 0.1292])\n",
    "        ph_12 = np.array([-0.0597, 0, -0.0097, 0.2716, 0.2427, 0.206, 0.1971])\n",
    "    elif date == '6Mar2024_03_51':\n",
    "        ph_01 = np.array([-0.0477, -0.0284, 0, 0.0218, -0.2450, -0.0685, 0.1217, 0.2343])\n",
    "        ph_12 = np.array([0.0294, 0.011, 0, -0.0223, 0.5448, 0.5625,  0.2096,  0.2841])\n",
    "    elif date == '20Feb2024_23_19':\n",
    "        ph_01 = np.array([0.1280, -0.022, -0.0286, 0, -0.131, 0.1443, 0.2638])\n",
    "        ph_12 = np.array([-0.2556, -0.1533, 0.0147, 0, -0.0135, 0.0125, -0.0446])\n",
    "    elif date == '5Feb2024_23-58-08':\n",
    "        ph_01 = np.array([0.0710,-.3306,-.1882,-.0431,0,-.0089,.1341,.0512,-.297,-0.4322])\n",
    "        ph_12 = np.array([0.0583,.1581,.018,-.0723,0,-.0004,-.0363,.0766,-.0785,-0.0095])\n",
    "    elif date == '6Mar2024_04_19':\n",
    "        ph_01 = np.array([-.2288,0,.2107,0,.359,0,.4176,-.0638])\n",
    "        ph_12 = np.array([-0.2903,0,-0.0231,0,-0.2805,0,0.0312, 0.0673])\n",
    "\n",
    "    del_phi_repeat_01 += ph_01[sat_idx]\n",
    "    del_phi_repeat_12 += ph_12[sat_idx]\n",
    "    \n",
    "    # delta phi from simulation\n",
    "    range_1 = np.linalg.norm(loc_sat-loc_1, axis=1)\n",
    "    range_0 = np.linalg.norm(loc_sat-loc_0, axis=1)\n",
    "    range_2 = np.linalg.norm(loc_sat-loc_2, axis=1)\n",
    "    del_phi_01_gt = -(range_0-range_1)/lam*2*np.pi\n",
    "    del_phi_12_gt = -(range_1-range_2)/lam*2*np.pi\n",
    "\n",
    "    range_1_coarse = np.linalg.norm(loc_sat_coarse-loc_1, axis=1)\n",
    "    range_0_coarse = np.linalg.norm(loc_sat_coarse-loc_0, axis=1)\n",
    "    range_2_coarse = np.linalg.norm(loc_sat_coarse-loc_2, axis=1)\n",
    "    del_phi_01_coarse = -(range_0_coarse-range_1_coarse)/lam*2*np.pi\n",
    "    del_phi_12_coarse = -(range_1_coarse-range_2_coarse)/lam*2*np.pi\n",
    "\n",
    "    # calculate gap\n",
    "    coeff_01 = np.polyfit(t_repeat, del_phi_repeat_01, 2, w=np.minimum(np.abs(dopp_track[:, 2]), np.abs(dopp_track[:, 3])))\n",
    "    coeff_12 = np.polyfit(t_repeat, del_phi_repeat_12, 2, w=np.minimum(np.abs(dopp_track[:, 3]), np.abs(dopp_track[:, 4])))\n",
    "    # gap_01 = np.mean(del_phi_01_gt-np.polyval(coeff_01, t_sim)).real\n",
    "    # gap_12 = np.mean(del_phi_12_gt-np.polyval(coeff_12, t_sim)).real\n",
    "    gap_01_coarse = np.mean(del_phi_01_coarse-np.polyval(coeff_01, t_sim)).real\n",
    "    gap_12_coarse = np.mean(del_phi_12_coarse-np.polyval(coeff_12, t_sim)).real\n",
    "\n",
    "    while np.abs(gap_01_coarse-np.mean(gap_01_coarse_arr)) > 1.5*np.pi:\n",
    "        tmp = 2*np.pi*np.sign(gap_01_coarse-np.mean(gap_01_arr))\n",
    "        gap_01_coarse -= tmp\n",
    "        del_phi_repeat_01 += tmp\n",
    "    while np.abs(gap_12_coarse-np.mean(gap_12_coarse_arr)) > 1.5*np.pi:\n",
    "        tmp = 2*np.pi*np.sign(gap_12_coarse-np.mean(gap_12_arr))\n",
    "        gap_12_coarse -= tmp\n",
    "        del_phi_repeat_12 += tmp\n",
    "\n",
    "    gap_01_coarse_arr = np.append(gap_01_coarse_arr, gap_01_coarse)\n",
    "    gap_12_coarse_arr = np.append(gap_12_coarse_arr, gap_12_coarse)\n",
    "\n",
    "    coeff_01 = np.polyfit(t_repeat, del_phi_repeat_01, 2, w=np.minimum(np.abs(dopp_track[:, 2]), np.abs(dopp_track[:, 3])))\n",
    "    coeff_12 = np.polyfit(t_repeat, del_phi_repeat_12, 2, w=np.minimum(np.abs(dopp_track[:, 3]), np.abs(dopp_track[:, 4])))\n",
    "    gap_01 = np.mean(del_phi_01_gt-np.polyval(coeff_01, t_sim)).real\n",
    "    gap_12 = np.mean(del_phi_12_gt-np.polyval(coeff_12, t_sim)).real\n",
    "\n",
    "    # fit the discrete data points with polynomial (second order)\n",
    "    coeff_01_list.append(np.polyfit(t_repeat, del_phi_repeat_01, 2, w=np.minimum(np.abs(dopp_track[:, 2]), np.abs(dopp_track[:, 3]))))\n",
    "    coeff_12_list.append(np.polyfit(t_repeat, del_phi_repeat_12, 2, w=np.minimum(np.abs(dopp_track[:, 3]), np.abs(dopp_track[:, 4]))))\n",
    "    del_phi_repeat_01_list.append(del_phi_repeat_01)\n",
    "    del_phi_repeat_12_list.append(del_phi_repeat_12)\n",
    "    del_phi_01_gt_list.append(del_phi_01_gt)\n",
    "    del_phi_12_gt_list.append(del_phi_12_gt)\n",
    "    gap_01_arr = np.append(gap_01_arr, gap_01)\n",
    "    gap_12_arr = np.append(gap_12_arr, gap_12)\n",
    "    az_gt_list.append(az_gt)\n",
    "    el_gt_list.append(el_gt)\n",
    "    range_gt_list.append(range_gt)\n",
    "    t_sim_arr.append(t_sim)\n",
    "\n",
    "# plot a large fig\n",
    "plt.figure(figsize=(10, 12))\n",
    "for sat_idx in range(sat_num):\n",
    "    dopp_track = dopp_track_dict[0, sat_idx]\n",
    "    t_sim = t_sim_arr[sat_idx]\n",
    "    plt.subplot(4, 3, sat_idx+1)\n",
    "    plt.plot(dopp_track[:, 0], del_phi_repeat_01_list[sat_idx]+np.mean(gap_01_arr), '.')\n",
    "    plt.plot(t_sim, np.polyval(coeff_01_list[sat_idx], t_sim)+np.mean(gap_01_arr), label='fit', linestyle='--')\n",
    "    plt.plot(t_sim, del_phi_01_gt_list[sat_idx], label='gt', linewidth=3)\n",
    "    plt.plot(dopp_track[:, 0], del_phi_repeat_12_list[sat_idx]+np.mean(gap_12_arr), '.')\n",
    "    plt.plot(t_sim, np.polyval(coeff_12_list[sat_idx], t_sim)+np.mean(gap_12_arr), label='fit', linestyle='--')\n",
    "    plt.plot(t_sim, del_phi_12_gt_list[sat_idx], label='gt', linewidth=3)\n",
    "    \n",
    "    plt.title('gap01='+str(round(gap_01_arr[sat_idx]-np.mean(gap_01_arr),3))+', gap12='+str(round(gap_12_arr[sat_idx]-np.mean(gap_12_arr),3)))\n",
    "plt.show()"
   ]
  },
  {
