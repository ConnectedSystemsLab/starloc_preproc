   "source": [
    "# plot max_phase_err_pergs\n",
    "# if a number is in remove_candidates, remove it from refined_candidates\n",
    "refined_candidates = list(set(refined_candidates) - set(remove_candidates))\n",
    "plt.figure()\n",
    "plt.stem(range(len(coarse_gs)), max_phase_err_pergs, markerfmt='+')\n",
    "plt.stem(refined_candidates, np.array(max_phase_err_pergs)[refined_candidates], markerfmt='*', linefmt='r', label='Potential candidate Locations')\n",
    "plt.xlabel('Candidate GS index', fontsize=16)\n",
    "plt.ylabel('Maximum phase difference slope-delta \\n with observed', fontsize=16)\n",
    "plt.legend(fontsize=16)\n",
    "plt.tight_layout()\n",
    "plt.savefig(date+'/max_phase_err_pergs.pdf')\n",
    "# plt.stem(best_candidate_idx, np.sum(min_param_diff_pertime_each_gs, axis=1)[best_candidate_idx],markerfmt='*', linefmt='r', label='Best candidate loc\\n'+str(best_coarse_gs_candidate))\n",
    "# plt.xlabel('Candidate GS index')\n",
    "# plt.ylabel('Minimum phase difference slope-delta with observed')\n",
