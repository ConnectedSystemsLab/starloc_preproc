    "from datetime import datetime\n",
    "import pytz\n",
    "date = os.path.join('/home/ishani/LeoPNT/starlink_ofdm/Starloc/results/final', date)\n",
    "print(date)\n",
    "start_time_datetime = datetime.fromtimestamp(start_time, tz=pytz.utc)\n",
    "tle_path = date+'/Starlink.tle'\n",
    "mat = sio.loadmat(date+'/phase_comp.mat')\n",
    "tracked_peaks = mat['dopp_track_dict'][0]\n",
    "# sort time_arr\n",
    "# time_arr = sorted(time_arr)\n",
    "print('time_arr: ', time_arr)\n",
    "time_arr = np.array(time_arr)\n",
    "%matplotlib widget\n",
    "# plt.figure(3)\n",
    "# plt.clf()\n",
    "fig, ax = plt.subplots(1,1,figsize=(10,6))\n",
    "# call get_candidate_locs\n",
    "from utils.satid_blind_identification import get_candidate_locs, get_candidate_locs_jida\n",
    "search_radius = 220 # in km\n",
    "gs_groups, coarse_gs, sat_groups = get_candidate_locs_jida(start_time_datetime, time_arr, is_middle_arr, tle_path, search_dist_bound=search_radius, fig_pointer=(fig, ax))\n",
    "# plot the ground truth location\n",
    "# get gt location from imu file\n",
    "from utils.imu_data import IMUData\n",
    "imu_data = IMUData(imu_path)\n",
    "lat_lon_alt = imu_data.get_latlonalt()\n",
    "# average out the lat lon alt\n",
    "lat_lon_alt_mean = np.mean(lat_lon_alt, axis=0)\n",
    "# ax.scatter(lat_lon_alt_mean[1], lat_lon_alt_mean[0], c='red', marker='*',s=30, label='True Location')\n",
    "ax.legend(fontsize=16)\n",
    "# ax.scatter(-88.20952606201173, 40.07216262817384, c='red', marker='*',s=15)\n",
    "ax.set_xlabel('Longitude', fontsize=16)\n",
    "ax.set_ylabel('Latitude', fontsize=16)\n",
    "# ax.set_title('Candidate Ground Station Locations')\n",
    "plt.savefig(date+'/candidate_gs.pdf')\n",
    "plt.show()"
   ]
  },
