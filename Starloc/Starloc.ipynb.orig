   "source": [
    "t_sim_list = sio.loadmat(date+'/output_doppler.mat')['t_list']\n",
    "dopp_track_dict = sio.loadmat(date+'/phase_comp.mat')['dopp_track_dict']\n",
    "dopp_track_main_dict = sio.loadmat(date+'/doppler_track.mat')['dopp_track_main_dict']\n",
    "id_dict = sio.loadmat(date+'/phase_comp.mat')['id_dict']\n",
    "sat_dopp_struct = sio.loadmat(date+'/phase_comp.mat')['sat_dopp_dict']\n",
    "ref_sig_idx = sio.loadmat(date+'/info.mat')['ref_sig_idx']\n",
    "phase_offset_01 = sio.loadmat(date+'/info.mat')['phase_offset_01'][0]\n",
    "phase_offset_21 = sio.loadmat(date+'/info.mat')['phase_offset_21'][0]\n",
    "sat_num = len(dopp_track_dict[0, :])\n",
    "time_arr, is_middle_arr, dopp_coeff_list = [], [], []\n",
    "pw_list_0, pw_list_1, pw_list_2 = [], [], []\n",
    "plt.figure(2)\n",
    "plt.clf()\n",
    "plt.subplot(2,1,1)\n",
    "for sat_idx in range(sat_num):\n",
    "    dopp_track = dopp_track_dict[0, sat_idx]\n",
    "    t_repeat = dopp_track[:, 0].real\n",
    "    dopp_repeat = dopp_track[:, 1].real\n",
    "    plt.plot(t_repeat, dopp_repeat, '.', label=id_dict[0, sat_idx][0], markersize=2)\n",
    "plt.show()\n",
    "plt.ylabel('doppler bin')\n",
    "# plt.legend(fontsize='x-small', loc='upper right')\n",
    "plt.subplot(2,1,2)\n",
    "for sat_idx in range(sat_num):\n",
    "    dopp_track = dopp_track_main_dict[0, sat_idx]\n",
    "    t_repeat = dopp_track[:, 0].real\n",
    "    dopp_repeat = dopp_track[:, 1].real\n",
    "    t_sat_start, t_sat_end = np.min(t_repeat), np.max(t_repeat)\n",
    "    p = np.polyfit(t_repeat, dopp_repeat, 3, w=np.abs(dopp_track[:, 2])**2)\n",
    "    t = np.arange(t_sat_start, t_sat_end, 0.001)\n",
    "    dopp = np.polyval(p, t)\n",
    "    dopp_diff = np.diff(dopp) / np.diff(t)\n",
    "    t_diff = t[0:-1] + 0.001 / 2\n",
    "    # find the min value of the derivative\n",
    "    min_idx = np.argmin(dopp_diff)\n",
    "    time_arr.append(t_diff[min_idx])\n",
    "    dopp_coeff_list.append(p)\n",
    "    pw_list_0.append(np.mean(np.abs(dopp_track[:, 2])**2))\n",
    "    pw_list_1.append(np.mean(np.abs(dopp_track[:, 3])**2))\n",
    "    pw_list_2.append(np.mean(np.abs(dopp_track[:, 4])**2))\n",
    "    is_middle_arr.append(min_idx != 0 and min_idx != len(dopp_diff)-1)\n",
    "    plt.plot(t_diff, dopp_diff, label=id_dict[0, sat_idx][0], markersize=2)\n",
    "    plt.scatter(t_diff[min_idx], dopp_diff[min_idx])\n",
    "plt.ylabel('doppler rate (Hz/s)')\n",
    "plt.xlabel('time (s)')\n",
    "is_middle_arr = np.array(is_middle_arr)"
   ]
  },
