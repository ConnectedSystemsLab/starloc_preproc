   ],
   "source": [
    "# do grid search for all satellites\n",
    "from tqdm import tqdm\n",
    "x_grid, y_grid = np.linspace(-10e3, 10e3, 200), np.linspace(-10e3, 10e3, 200)\n",
    "err_min = np.inf\n",
    "num_sat_for_training = round(sat_num/2)\n",
    "num_sat_for_testing = sat_num - num_sat_for_training\n",
    "for x in x_grid:\n",
    "    for y in y_grid:\n",
    "        err = 0\n",
    "        # add some offset to the ground truth location\n",
    "        loc_1_, loc_0_, loc_2_ = loc_1+np.array([x,y,0]), loc_0+np.array([x,y,0]), loc_2+np.array([x,y,0])\n",
    "        for sat_idx in range(sat_num):\n",
    "            if sat_idx < num_sat_for_training:\n",
    "                continue\n",
    "\n",
    "            t_sim = t_sim_arr[sat_idx]\n",
    "            mes_12 = np.polyval(coeff_12_list[sat_idx], t_sim)+np.mean(gap_12_arr[0:num_sat_for_training])\n",
    "            mes_01 = np.polyval(coeff_01_list[sat_idx], t_sim)+np.mean(gap_01_arr[0:num_sat_for_training])\n",
    "            # mes_12 = np.polyval(coeff_12_list[sat_idx], t_sim)+gap_12_arr[sat_idx]\n",
    "            # mes_01 = np.polyval(coeff_01_list[sat_idx], t_sim)+gap_01_arr[sat_idx]\n",
    "            mes_12_diff = np.diff(mes_12)\n",
    "            mes_01_diff = np.diff(mes_01)\n",
    "            \n",
    "            az_gt, el_gt, range_gt = az_gt_list[sat_idx], el_gt_list[sat_idx], range_gt_list[sat_idx]\n",
    "            loc_sat = np.column_stack((range_gt * np.cos(el_gt) * np.sin(az_gt),\n",
    "                         range_gt * np.cos(el_gt) * np.cos(az_gt),\n",
    "                         range_gt * np.sin(el_gt)))    # the unit vector pointing to the sat from the origin\n",
    "\n",
    "            range_1 = np.linalg.norm(loc_sat-loc_1_, axis=1)\n",
    "            range_0 = np.linalg.norm(loc_sat-loc_0_, axis=1)\n",
    "            range_2 = np.linalg.norm(loc_sat-loc_2_, axis=1)\n",
    "            del_phi_01_gt = -(range_0-range_1)/lam*2*np.pi\n",
    "            del_phi_12_gt = -(range_1-range_2)/lam*2*np.pi\n",
    "\n",
    "            \n",
    "            err += np.sum(np.abs(mes_12-del_phi_12_gt))*(pw_list_1[sat_idx]+pw_list_2[sat_idx]) + np.sum(np.abs(mes_01-del_phi_01_gt))*(pw_list_0[sat_idx]+pw_list_1[sat_idx])\n",
    "            # err += np.sum(np.abs(mes_12_diff-np.diff(del_phi_12_gt)))+np.sum(np.abs(mes_01_diff-np.diff(del_phi_01_gt)))\n",
    "        # print(err)\n",
    "        if err < err_min:\n",
    "            err_min = err\n",
    "            loc_min = np.array([x,y])\n",
    "loc_aoa_overall_2d = loc_min\n",
    "loc_aoa_overall_err = np.linalg.norm(loc_aoa_overall_2d)\n",
    "# print(loc_aoa_overall_2d, loc_aoa_overall_err)\n",
    "\n",
    "loc_aoa_list = []\n",
    "for i in tqdm(range(num_sat_for_training, sat_num)):\n",
    "    err_min = np.inf\n",
    "    for x in x_grid:\n",
    "        for y in y_grid:\n",
    "            err = 0\n",
    "            # add some offset to the ground truth location\n",
    "            loc_1_, loc_0_, loc_2_ = loc_1+np.array([x,y,0]), loc_0+np.array([x,y,0]), loc_2+np.array([x,y,0])\n",
    "            for sat_idx in [i]:\n",
    "                t_sim = t_sim_arr[sat_idx]\n",
    "                mes_12 = np.polyval(coeff_12_list[sat_idx], t_sim)+np.mean(gap_12_arr[0:num_sat_for_training])\n",
    "                mes_01 = np.polyval(coeff_01_list[sat_idx], t_sim)+np.mean(gap_01_arr[0:num_sat_for_training])\n",
    "                # mes_12 = np.polyval(coeff_12_list[sat_idx], t_sim)+gap_12_arr[sat_idx]\n",
    "                # mes_01 = np.polyval(coeff_01_list[sat_idx], t_sim)+gap_01_arr[sat_idx]\n",
    "                mes_12_diff = np.diff(mes_12)\n",
    "                mes_01_diff = np.diff(mes_01)\n",
    "                \n",
    "                az_gt, el_gt, range_gt = az_gt_list[sat_idx], el_gt_list[sat_idx], range_gt_list[sat_idx]\n",
    "                loc_sat = np.column_stack((range_gt * np.cos(el_gt) * np.sin(az_gt),\n",
    "                            range_gt * np.cos(el_gt) * np.cos(az_gt),\n",
    "                            range_gt * np.sin(el_gt)))    # the unit vector pointing to the sat from the origin\n",
    "\n",
    "                range_1 = np.linalg.norm(loc_sat-loc_1_, axis=1)\n",
    "                range_0 = np.linalg.norm(loc_sat-loc_0_, axis=1)\n",
    "                range_2 = np.linalg.norm(loc_sat-loc_2_, axis=1)\n",
    "                del_phi_01_gt = -(range_0-range_1)/lam*2*np.pi\n",
    "                del_phi_12_gt = -(range_1-range_2)/lam*2*np.pi\n",
    "\n",
    "                if sat_idx < num_sat_for_training:\n",
    "                    continue\n",
    "                err += np.sum(np.abs(mes_12-del_phi_12_gt))*(pw_list_1[sat_idx]+pw_list_2[sat_idx]) + np.sum(np.abs(mes_01-del_phi_01_gt))*(pw_list_0[sat_idx]+pw_list_1[sat_idx])\n",
    "                # err += np.sum(np.abs(mes_12_diff-np.diff(del_phi_12_gt)))+np.sum(np.abs(mes_01_diff-np.diff(del_phi_01_gt)))\n",
    "            # print(err)\n",
    "            if err < err_min:\n",
    "                err_min = err\n",
    "                loc_min = np.array([x,y])\n",
    "    # print('sat #'+str(i), loc_min, np.linalg.norm(loc_min))\n",
    "    loc_aoa_list.append(loc_min)\n",
    "\n",
    "print(loc_aoa_overall_2d, loc_aoa_overall_err)\n",
    "for i in range(num_sat_for_testing):\n",
    "    print('sat #'+str(i+num_sat_for_training), loc_aoa_list[i], np.linalg.norm(loc_aoa_list[i]))"
   ]
  },
